{
  "sessionDir": "~/.pi/agent/herd",
  "maxModelConcurrent": 2,
  "local": {
    "enabled": true,
    "model": "vllm/Qwen/Qwen3.6-27B-FP8",
    "thinking": "medium",
    "maxStreams": 1,
    "preflight": true,
    "preferOn": ["easy", "medium"],
    "whenFull": "queue"
  },
  "easy": [
    {
      "model": "vllm/Qwen/Qwen3.6-27B-FP8",
      "thinking": "medium",
      "local": true
    },
    {
      "model": "openai-codex/gpt-5.6-luna",
      "thinking": "medium"
    }
  ],
  "medium": [
    {
      "model": "grok-cli/grok-4.5",
      "thinking": "medium"
    },
    {
      "model": "openai-codex/gpt-5.6-terra",
      "thinking": "medium"
    }
  ],
  "hard": [
    {
      "model": "claude-code/claude-opus-5",
      "thinking": "high"
    },
    {
      "model": "openai-codex/gpt-5.6-sol",
      "thinking": "high"
    }
  ],
  "defaults": {
    "isolation": "none",
    "timeoutMs": 600000,
    "waitForReply": false,
    "requireOutput": true,
    "resultDelivery": "pointer",
    "triggerTurnOnResult": true
  }
}
