{
  "sessionDir": "~/.pi/agent/herd",
  "maxModelConcurrent": 2,
  "local": {
    "enabled": true,
    "model": "vllm/Qwen/Qwen3.6-27B-FP8",
    "thinking": "medium",
    "preflight": true
  },
  "think": [
    {
      "model": "grok-cli/grok-4.6",
      "thinking": "high"
    },
    {
      "model": "openai-codex/gpt-5.6-sol",
      "thinking": "high"
    }
  ],
  "private": {
    "enabled": false
  },
  "defaults": {
    "isolation": "none",
    "timeoutMs": 600000,
    "waitForReply": false,
    "requireOutput": true,
    "resultDelivery": "pointer",
    "triggerTurnOnResult": true
  }
}
