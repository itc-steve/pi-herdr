{
  "name": "@itc-steve/pi-herdr",
  "version": "2.0.0",
  "description": "Pi extension for Herdr-visible agent-chosen workers, queued tasks, write lanes, and private-local operations.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "herdr",
    "herd",
    "multi-agent",
    "agent-chosen",
    "vllm",
    "pane-management"
  ],
  "author": {
    "name": "itc-steve",
    "url": "https://github.com/itc-steve"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itc-steve/pi-herdr.git"
  },
  "bugs": {
    "url": "https://github.com/itc-steve/pi-herdr/issues"
  },
  "homepage": "https://github.com/itc-steve/pi-herdr#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "index.ts",
    "src",
    "skills",
    "herd.json.example",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "26.0.0",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  }
}
